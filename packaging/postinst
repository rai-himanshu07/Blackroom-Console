#!/bin/sh
# Installing changes nothing about remote access: no unit is enabled or started, no credential is created.
set -e
if [ "$1" = configure ]; then
  cat <<'MSG'

Blackroom Console is installed. Remote access stays OFF until you set it up, in the pages:
  1. Open "Blackroom Console" from the applications menu (it starts the console and opens Host settings).
  2. Follow the "First steps" card: set up sign-in, then allow keyboard blocking.
From a terminal instead: blackroom setup; sudo blackroom-grant-input grant; systemctl --user start blackroom-console.service
Read /usr/share/doc/blackroom-console/runbook.md. Remove with: apt remove blackroom-console

MSG
fi
exit 0
